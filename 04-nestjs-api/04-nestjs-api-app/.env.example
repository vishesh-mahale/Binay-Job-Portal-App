NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:replace-with-local-secret@localhost:5432/binay
# Preferred for current Supabase ECC signing keys; derive from SUPABASE_URL when omitted.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Legacy HS256 fallback only; do not use when JWKS is configured.
SUPABASE_JWT_SECRET=replace-with-legacy-secret-manager-value
# Required before production auth freeze; use the exact issuer/audience from the Supabase project.
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
LOG_LEVEL=info
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
RESUME_STORAGE_BUCKET=private-documents
RESUME_MAX_BYTES=10485760
GUEST_UPLOAD_SESSION_TTL_SECONDS=3600
GUEST_CLAIM_TTL_SECONDS=86400
## Comma-separated browser origins; leave unset until environment hostnames are approved
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
ALLOWED_OAUTH_PROVIDERS=
OAUTH_CALLBACK_URL=
OAUTH_FRONTEND_SUCCESS_URL=
OAUTH_FRONTEND_ERROR_URL=
OAUTH_STATE_SECRET=
OAUTH_STATE_TTL_SECONDS=600
