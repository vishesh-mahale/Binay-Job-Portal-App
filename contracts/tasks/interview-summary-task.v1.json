{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binay-job-portal.internal/contracts/tasks/interview-summary-task.v1.json",
  "title": "InterviewSummaryTaskPayloadV1",
  "description": "Payload for Cloud Task that generates AI summary of interview feedback",
  "type": "object",
  "required": ["schema_version", "event_id", "aggregate_id", "trace_id"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid",
      "description": "The interview UUID"
    },
    "trace_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": false
}
