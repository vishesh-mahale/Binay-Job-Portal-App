{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/tasks/job-enrich-task.v1.json",
  "title": "Job Enrichment Task",
  "description": "Cloud Task payload for job AI profile and embedding enrichment",
  "type": "object",
  "required": ["schema_version", "event_id", "aggregate_id", "trace_id"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Contract schema version"
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Outbox event UUID (idempotency key)"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid",
      "description": "Job UUID"
    },
    "trace_id": {
      "type": "string",
      "format": "uuid",
      "description": "Distributed tracing ID"
    }
  },
  "additionalProperties": false
}
