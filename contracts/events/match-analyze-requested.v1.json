{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binay-job-portal.internal/contracts/events/match-analyze-requested.v1.json",
  "title": "MatchAnalyzeRequestedEventV1",
  "description": "Transactional outbox event emitted when a job application is submitted and requires AI match/gap analysis",
  "type": "object",
  "required": ["schema_version", "event_id", "aggregate_type", "aggregate_id", "event_type", "payload", "occurred_at"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique UUID for this trigger event"
    },
    "aggregate_type": {
      "type": "string",
      "const": "job_application"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid",
      "description": "The job_application UUID to analyze"
    },
    "event_type": {
      "type": "string",
      "const": "match.analyze.requested"
    },
    "payload": {
      "type": "object",
      "required": ["job_id", "candidate_id", "application_id"],
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid",
          "description": "The job being applied to"
        },
        "candidate_id": {
          "type": "string",
          "format": "uuid",
          "description": "The candidate applying"
        },
        "application_id": {
          "type": "string",
          "format": "uuid",
          "description": "The job_application row UUID"
        },
        "trace_id": {
          "type": "string",
          "format": "uuid",
          "description": "Distributed tracing UUID (optional, falls back to event_id)"
        }
      },
      "additionalProperties": false
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "_draft_note": "G-1 pending — producer (04-nestjs-api) trigger contract not yet frozen"
}
