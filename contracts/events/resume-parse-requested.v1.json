{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resume Parse Requested Event",
  "description": "Emitted when a resume parsing job is queued.",
  "type": "object",
  "required": ["schema_version", "event_id", "aggregate_id", "trace_id"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "event_id": {"type": "string", "format": "uuid"},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "trace_id": {"type": "string", "format": "uuid"},
    "document_id": {"type": "string", "format": "uuid"},
    "requested_by": {"type": "string", "format": "uuid"}
  },
  "additionalProperties": false
}
