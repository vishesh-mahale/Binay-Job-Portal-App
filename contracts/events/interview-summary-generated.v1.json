{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binay-job-portal.internal/contracts/events/interview-summary-generated.v1.json",
  "title": "InterviewSummaryGeneratedEventV1",
  "description": "Transactional outbox event emitted after interview AI summary generation",
  "type": "object",
  "required": ["schema_version", "event_id", "aggregate_type", "aggregate_id", "event_type", "payload", "occurred_at"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "event_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "type": "string", "const": "interview" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "const": "interview.summary_generated" },
    "payload": {
      "type": "object",
      "required": ["interview_id", "participant_id", "trace_id"],
      "properties": {
        "interview_id": { "type": "string", "format": "uuid" },
        "participant_id": { "type": "string", "format": "uuid" },
        "trace_id": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false
    },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
