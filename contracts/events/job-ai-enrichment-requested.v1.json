{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Job AI Enrichment Requested Event",
  "description": "Emitted when a job needs AI enrichment and embedding.",
  "type": "object",
  "required": ["schema_version", "event_id", "aggregate_id", "trace_id"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "event_id": {"type": "string", "format": "uuid"},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "trace_id": {"type": "string", "format": "uuid"},
    "job_id": {"type": "string", "format": "uuid"},
    "trigger": {"type": "string", "enum": ["created", "updated", "reparsed"]}
  },
  "additionalProperties": false
}
