{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binay-job-portal.internal/contracts/events/job-screening-questions-generated.v1.json",
  "title": "JobScreeningQuestionsGeneratedEventV1",
  "description": "Transactional outbox event emitted after job screening questions generation",
  "type": "object",
  "required": ["schema_version", "event_id", "aggregate_type", "aggregate_id", "event_type", "payload", "occurred_at"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "event_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "type": "string", "const": "job" },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "const": "job.screening_questions_generated" },
    "payload": {
      "type": "object",
      "required": ["job_id", "questions_count", "trace_id"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "questions_count": { "type": "integer", "minimum": 1 },
        "trace_id": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false
    },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
