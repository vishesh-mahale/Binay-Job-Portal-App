{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://binay-job-portal.internal/contracts/events/interview-summary-requested.v1.json",
  "title": "InterviewSummaryRequestedEventV1",
  "description": "Transactional outbox event emitted when an interview is completed and requires AI summary generation",
  "type": "object",
  "required": ["schema_version", "event_id", "aggregate_type", "aggregate_id", "event_type", "payload", "occurred_at"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique UUID for this trigger event"
    },
    "aggregate_type": {
      "type": "string",
      "const": "interview"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid",
      "description": "The interview UUID to summarize"
    },
    "event_type": {
      "type": "string",
      "const": "interview.summary.requested"
    },
    "payload": {
      "type": "object",
      "required": ["interview_id", "job_id", "candidate_id"],
      "properties": {
        "interview_id": {
          "type": "string",
          "format": "uuid",
          "description": "The interview row UUID"
        },
        "job_id": {
          "type": "string",
          "format": "uuid",
          "description": "The job this interview is for"
        },
        "candidate_id": {
          "type": "string",
          "format": "uuid",
          "description": "The candidate being interviewed"
        },
        "trace_id": {
          "type": "string",
          "format": "uuid",
          "description": "Distributed tracing UUID (optional, falls back to event_id)"
        }
      },
      "additionalProperties": false
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "_draft_note": "G-1 pending — producer (04-nestjs-api) trigger contract not yet frozen"
}
