# ============================================================================
# FastAPI AI Worker — Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in actual values for your deployment.
# Never commit secrets to version control.

# ============================================================================
# Database & Persistence
# ============================================================================

# Supabase PostgreSQL connection string (production must use SSL)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/binay_job_portal
DATABASE_MAX_POOL_SIZE=20
DATABASE_MIN_POOL_SIZE=5
DATABASE_COMMAND_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_SECONDS=120

# ============================================================================
# Google Cloud & OIDC Authentication
# ============================================================================

# Google Cloud project ID (same as GCP project)
GOOGLE_CLOUD_PROJECT_ID=binay-job-portal-prod

# Comma-separated list of allowed service account emails for Cloud Tasks
# Only these identities can invoke this service
GOOGLE_OIDC_ALLOWED_SERVICE_ACCOUNTS=cloud-tasks-invoker@binay-job-portal-prod.iam.gserviceaccount.com

# Enable/disable OIDC token validation (set to false for local development only)
OIDC_AUTH_ENABLED=true

# Expected audience for OIDC tokens (usually the Cloud Run service URL)
OIDC_TOKEN_AUDIENCE=https://fastapi-ai-worker-abc123.run.app

# ============================================================================
# AI Providers & Language Models (4 Universal Modes Supported)
# ============================================================================

# Primary AI provider selection: vertexai (recommended), gemini, openai, mock
AI_PROVIDER=vertexai

# Embedding model provider: vertexai, gemini, openai, mock
EMBEDDING_PROVIDER=vertexai
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# ----------------------------------------------------------------------------
# Option 1: Google Cloud Vertex AI (0-Key IAM Mode — Recommended Prod & Local ADC)
# ----------------------------------------------------------------------------
# No API keys required! Uses Google Cloud Service Account on Cloud Run,
# or `gcloud auth application-default login` on local development machine.
GCP_REGION=asia-south1
GEMINI_MODEL=gemini-2.0-flash

# ----------------------------------------------------------------------------
# Option 2: Google AI Studio (API Key Mode — Free Developer Tier)
# ----------------------------------------------------------------------------
# Required ONLY when AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=2048

# ----------------------------------------------------------------------------
# Option 3: OpenAI (API Key Mode)
# ----------------------------------------------------------------------------
# Required ONLY when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.2

# ----------------------------------------------------------------------------
# Option 4: Local Offline Mock Mode (For Testing / CI/CD)
# ----------------------------------------------------------------------------
# Set AI_PROVIDER=mock and EMBEDDING_PROVIDER=mock (Zero network calls, ₹0)

# ============================================================================
# Document Processing & Extraction
# ============================================================================

# Maximum document size allowed (bytes)
MAX_DOCUMENT_SIZE_BYTES=10485760  # 10 MB

# Maximum extracted text length (characters)
MAX_EXTRACTED_TEXT_LENGTH=100000

# Maximum PDF pages to process
MAX_PDF_PAGES=10

# Maximum DOCX ZIP entries
MAX_DOCX_ENTRIES=1000

# PDF extraction timeout (seconds)
PDF_EXTRACTION_TIMEOUT_SECONDS=30

# OCR timeout (seconds)
OCR_TIMEOUT_SECONDS=60

# Tesseract OCR binary path (default: assumes system PATH)
TESSERACT_CMD=/usr/bin/tesseract

# ============================================================================
# Logging & Observability
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=info

# Structured logging format: json, text
LOG_FORMAT=json

# Request tracing header name (for distributed tracing)
TRACE_ID_HEADER=x-trace-id

# Enable PII/credential redaction in logs
LOG_REDACT_PII=true

# ============================================================================
# Cloud Storage (Supabase Storage)
# ============================================================================

# Supabase Storage bucket name for document uploads
SUPABASE_STORAGE_BUCKET=job-portal-uploads

# Supabase Storage service role key (high privilege, use with care)
SUPABASE_STORAGE_KEY=your-supabase-service-role-key

# Private ClamAV daemon used by /internal/tasks/security/scan.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=60

# Supabase project URL
SUPABASE_PROJECT_URL=https://your-project.supabase.co

# Signed URL expiry (seconds)
SIGNED_URL_EXPIRY_SECONDS=900  # 15 minutes

# ============================================================================
# Processing Timeouts & Retry Strategy
# ============================================================================

# Event processing lease duration (seconds)
LEASE_DURATION_SECONDS=300  # 5 minutes

# Lease cleanup interval (seconds)
LEASE_CLEANUP_INTERVAL_SECONDS=600  # 10 minutes

# Stale lease cleanup threshold (seconds)
STALE_LEASE_THRESHOLD_SECONDS=3600  # 1 hour

# Max concurrent tasks per worker instance
MAX_CONCURRENT_TASKS=10

# ============================================================================
# Security & Authorization
# ============================================================================

# Secret key for session/token signing (not used for OIDC; JWT already signed by Google)
SECRET_KEY=your-secret-key-here-min-32-chars-recommended

# Allowed origins for CORS (if exposed via public API; this worker is private)
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# Feature Flags & Debugging
# ============================================================================

# Enable/disable AI provider mock mode for testing (overrides AI_PROVIDER)
MOCK_AI_PROVIDER=false

# Enable debug endpoints (health, status, etc.)
DEBUG_ENDPOINTS_ENABLED=false

# Enable full exception stack traces in error responses
DEBUG_FULL_TRACEBACK=false

# ============================================================================
# Performance & Concurrency
# ============================================================================

# Worker concurrency level
WORKER_CONCURRENCY=5

# Event loop thread pool workers
LOOP_WORKERS=4

# ============================================================================
# Cleanup & Retention
# ============================================================================

# Processed events retention period (days)
PROCESSED_EVENTS_RETENTION_DAYS=30

# Resume parsing artifacts retention period (days)
RESUME_ARTIFACTS_RETENTION_DAYS=7

# Raw AI output retention period (days); set to 0 to disable storage
RAW_AI_OUTPUT_RETENTION_DAYS=0  # Don't store PII indefinitely
