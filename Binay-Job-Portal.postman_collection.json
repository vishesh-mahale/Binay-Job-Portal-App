  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Liveness Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/liveness",
            "description": "Returns OK if server is running. No auth required."
          }
        },
        {
          "name": "Readiness Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/readiness",
            "description": "Returns OK if DB is connected. No auth required."
          }
        }
      ]
    },
    {
      "name": "1. Authentication",
      "description": "Signup, Login, Refresh, Logout flow.\n\n**Postman Setup:**\n1. Call `Login` → cookies are auto-set\n2. All other requests will use those cookies automatically\n3. Or extract `access_token` from response and use Bearer header",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/signup",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"TestPassword123!\",\n  \"register_as\": \"candidate\"\n}"
            },
            "description": "Create a new user account. Sets cookies if Supabase auto-confirm is on.\n\n**Body:**\n- `email` (required)\n- `password` (required)\n- `register_as`: `candidate` | `recruiter`"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"TestPassword123!\"\n}"
            },
            "description": "Login with email/password. Server sets 3 cookies:\n- `binay_access_token`\n- `binay_refresh_token`\n- `binay_presence_session`\n\n**Postman:** Go to Cookies tab to see them, or extract `access_token` from response body for Bearer auth."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "description": "Refreshes access token using `binay_refresh_token` cookie.\n\n**Important:** The refresh token cookie path is `/api/v1/auth/refresh`, so Postman must send it. If using cookies, it works automatically. If using Bearer, pass the refresh token separately."
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Returns current authenticated user profile.\n\nRequires: `binay_access_token` cookie or `Authorization: Bearer <token>`"
          }
        },
        {
          "name": "List Sessions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/sessions",
            "description": "List all active sessions for the current user."
          }
        },
        {
          "name": "Revoke Session",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/sessions/revoke",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"<session-uuid>\"\n}"
            },
            "description": "Revoke a presence session by session ID."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/change-password",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"OldPassword123!\",\n  \"new_password\": \"NewPassword456!\"\n}"
            },
            "description": "Change password for authenticated user. Invalidates all existing tokens."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/forgot-password",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\"\n}"
            },
            "description": "Send password reset email. No auth required."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/reset-password",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recovery_token\": \"<token-from-email>\",\n  \"new_password\": \"NewPassword789!\"\n}"
            },
            "description": "Reset password using recovery token from email. No auth required."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Logout and clear all cookies. Marks session as offline."
          }
        }
      ]
    },
    {
      "name": "2. Company Setup",
      "description": "Create and manage your company. After signup, recruiter creates a company first.",
      "item": [
        {
          "name": "Create Company",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/companies",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Company\",\n  \"slug\": \"my-company\",\n  \"email\": \"hr@mycompany.com\",\n  \"phone\": \"+91-9876543210\"\n}"
            },
            "description": "Create a new company. The creator becomes the owner."
          }
        },
        {
          "name": "Get My Company",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/companies/me",
            "description": "Get the current user's company."
          }
        },
        {
          "name": "Get Company by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}",
            "description": "Get company details by ID."
          }
        },
        {
          "name": "Update Company",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Company Name\",\n  \"description\": \"We are a tech company\"\n}"
            },
            "description": "Update company details. Only owner/admin can update."
          }
        },
        {
          "name": "Get Company Settings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/settings",
            "description": "Get company settings."
          }
        },
        {
          "name": "Update Company Settings",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/settings",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
