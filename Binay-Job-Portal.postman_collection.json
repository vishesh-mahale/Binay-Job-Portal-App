                },
                {
                  "key": "set_as_active",
                  "value": "true",
                  "type": "text"
                }
              ]
            },
            "description": "Upload a resume file (PDF/DOCX). Triggers security scan + AI parsing.\n\nResponse includes `document_id` and `parsing_job_id`. Use those to poll status."
