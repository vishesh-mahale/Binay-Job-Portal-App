              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expected_profile_revision\": 1,\n  \"profile\": {\n    \"professional_title\": \"Senior Full Stack Developer\",\n    \"summary\": \"...\",\n    \"current_location\": \"Mumbai\"\n  },\n  \"facts\": {\n    \"skills\": [],\n    \"experiences\": [],\n    \"educations\": [],\n    \"certifications\": [],\n    \"projects\": [],\n    \"languages\": [],\n    \"awards\": [],\n    \"links\": []\n  }\n}"
            },
            "description": "Confirm resume and optionally auto-fill profile on first time.\n\nOn first resume (profile_completed_at IS NULL): auto-fills profile + facts from resume AI data.\nOn subsequent resumes: only sets the resume as active, no auto-fill."
