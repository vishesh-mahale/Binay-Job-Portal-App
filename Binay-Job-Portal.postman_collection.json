              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expected_profile_revision\": 1\n}"
            },
            "description": "Delete a single fact by type and ID.\n\nfactType: skills|experiences|educations|certifications|projects|languages|awards|links"
