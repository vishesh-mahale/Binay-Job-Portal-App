            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs?q=developer&employment_type=full_time&work_mode=remote&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs"],
              "query": [
                { "key": "q", "value": "developer", "description": "Search keyword" },
                { "key": "employment_type", "value": "full_time", "description": "full_time|part_time|contract|internship" },
                { "key": "work_mode", "value": "remote", "description": "remote|hybrid|onsite" },
                { "key": "country", "value": "India", "description": "Country filter" },
                { "key": "category_id", "value": "", "description": "Category UUID" },
                { "key": "limit", "value": "10", "description": "Results per page" },
                { "key": "cursor", "value": "", "description": "Pagination cursor" }
              ]
            },
            "description": "Search and filter jobs. No auth required."
          }
        },
        {
          "name": "Get Job by Slug",
