            "method": "GET",
            "url": "{{baseUrl}}/api/v1/candidates/me",
            "description": "Get full candidate profile with skills, experiences, education, etc."
          }
        },
        {
          "name": "Update Profile Fields",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/candidates/me",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"professional_title\": \"Senior Full Stack Developer\",\n  \"summary\": \"Experienced developer with 9+ years...\",\n  \"current_location\": \"Mumbai\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"country\": \"India\",\n  \"preferred_work_mode\": \"remote\",\n  \"notice_period_days\": 30,\n  \"expected_salary_min\": 1500000,\n  \"expected_salary_max\": 3000000,\n  \"salary_currency\": \"INR\",\n  \"is_open_to_work\": true\n}"
            },
            "description": "Update candidate profile fields. Must include `expected_profile_revision` for optimistic concurrency."
          }
        },
        {
          "name": "Update Candidate Facts (Skills/Experience/etc)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/candidates/me/facts",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expected_profile_revision\": 1,\n  \"skills\": [\n    { \"name\": \"Java\", \"proficiency_level\": 8, \"years_of_experience\": 9 },\n    { \"name\": \"Angular\", \"proficiency_level\": 8, \"years_of_experience\": 7 }\n  ],\n  \"experiences\": [\n    {\n      \"company_name\": \"TCS\",\n      \"job_title\": \"Senior Developer\",\n      \"employment_type\": \"full_time\",\n      \"start_date\": \"2020-01\",\n      \"end_date\": null,\n      \"is_current\": true,\n      \"responsibilities\": [\"Led team of 5\"],\n      \"achievements\": []\n    }\n  ],\n  \"educations\": [\n    {\n      \"institution_name\": \"University of Mumbai\",\n      \"degree\": \"B.E.\",\n      \"field_of_study\": \"Computer Science\",\n      \"start_date\": \"2011\",\n      \"end_date\": \"2015\"\n    }\n  ],\n  \"certifications\": [],\n  \"projects\": [],\n  \"languages\": [\n    { \"language_name\": \"English\", \"proficiency\": \"Fluent\" }\n  ],\n  \"awards\": [],\n  \"links\": []\n}"
            },
            "description": "Update all candidate facts at once. Soft-deletes existing facts and inserts new ones.\n\nSupported factTypes: skills, experiences, educations, certifications, projects, languages, awards, links."
