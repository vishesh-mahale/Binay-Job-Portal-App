    {
      "name": "6. Jobs (Company - Recruiter)",
      "description": "Job management for recruiters. Auth required.",
      "item": [
        {
          "name": "List Company Jobs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/jobs"
          }
        },
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/jobs",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior Backend Developer\",\n  \"slug\": \"senior-backend-developer\",\n  \"description\": \"We are looking for a senior backend developer...\",\n  \"employment_type\": \"full_time\",\n  \"work_mode\": \"remote\",\n  \"country\": \"India\",\n  \"city\": \"Mumbai\",\n  \"salary_min\": 1500000,\n  \"salary_max\": 3000000,\n  \"salary_currency\": \"INR\",\n  \"experience_min_years\": 5,\n  \"experience_max_years\": 10\n}"
            },
            "description": "Create a new job posting. Starts in `draft` status."
          }
        },
        {
          "name": "Get Company Job",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/jobs/{{jobId}}"
          }
        },
        {
          "name": "Update Job",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/jobs/{{jobId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Job Title\",\n  \"description\": \"Updated description\"\n}"
            }
          }
        },
        {
          "name": "Submit for Approval",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/jobs/{{jobId}}/submit-for-approval",
            "description": "Submit draft job for admin approval (if job_approval_required is true)."
          }
        },
        {
          "name": "Approve Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/jobs/{{jobId}}/approve",
            "description": "Approve a pending job. Owner/admin only."
          }
        },
        {
          "name": "Reject Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/jobs/{{jobId}}/reject",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Job description needs more details\"\n}"
            }
          }
        },
        {
          "name": "Publish Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/jobs/{{jobId}}/publish",
            "description": "Publish a draft/approved job. Makes it visible to candidates."
          }
        },
        {
          "name": "Pause Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/jobs/{{jobId}}/pause",
            "description": "Pause a published job. Hides from search but keeps data."
          }
        },
        {
          "name": "Resume Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/jobs/{{jobId}}/resume",
            "description": "Resume a paused job."
          }
        },
        {
          "name": "Close Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/jobs/{{jobId}}/close",
            "description": "Close a job. No longer accepts applications."
          }
        },
        {
          "name": "Archive Job",
          "request": {
            "method": "POST",
