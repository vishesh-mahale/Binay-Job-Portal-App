    {
      "name": "4. Company Membership",
      "description": "Invite, accept, leave, rejoin, deactivate members.",
      "item": [
        {
          "name": "Invite Member",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/invitations",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newmember@example.com\",\n  \"title\": \"Software Engineer\"\n}"
            },
            "description": "Send invitation to join company. Creates a pending invitation."
          }
        },
        {
          "name": "List Invitations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/invitations"
          }
        },
        {
          "name": "Resend Invitation",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/companies/{{companyId}}/invitations/{{invitationId}}/resend"
          }
        },
        {
          "name": "Revoke Invitation",
