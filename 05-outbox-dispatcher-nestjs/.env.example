# Outbox Dispatcher — Phase 1 environment template (placeholders ONLY).
# Copy to .env for local development. NEVER commit real values (.gitignore covers .env).
# Boot fails fast if required values are missing — by design.

# development | test | production
NODE_ENV=development
PORT=3000

# --- Database (Supabase) ---------------------------------------------------
# Local/dev: direct session pool (5432).
# Production default: Transaction Pooler (6543) — serverless-friendly.
# Use the baseline `postgres` credential; service_role is an API/JWT concept,
# NOT a pg login. A dedicated LOGIN role + GRANT EXECUTE migration is OD-1.
DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/postgres

# --- Dispatch mode ---------------------------------------------------------
# direct      = DirectHttpPublisher → local FastAPI worker (dev only;
#               env validation rejects direct + NODE_ENV=production)
# cloud_tasks = CloudTasksPublisher — NOT implemented in Phase 1 (gates G-3/G-4)
DISPATCH_MODE=direct

# Required when DISPATCH_MODE=direct
FASTAPI_WORKER_URL=http://127.0.0.1:8000

# --- Wake endpoint auth (Supabase webhook → dispatcher) ---------------------
# Shared secret sent as the x-webhook-secret header. No defaults allowed.
WEBHOOK_SECRET=REPLACE_ME
# Optional previous secret, accepted during a rotation window only.
WEBHOOK_SECRET_PREVIOUS=

# --- Claim / drain tuning (bounds owned by 15_infrastructure.sql) -----------
# claim_outbox_events(): batch 1..100, lease 30..900
CLAIM_BATCH_SIZE=50
CLAIM_LEASE_SECONDS=300
# Bounded drain per wake: max batches per iteration (plan default 5 x 50).
DRAIN_MAX_BATCHES=5
# Must stay below the Cloud Run 300s request timeout (plan: 240s).
DRAIN_REQUEST_BUDGET_MS=240000
